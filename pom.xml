<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>org.addy</groupId>
	<artifactId>addy-swing</artifactId>
	<version>2.0.0</version>
	<name>Addy Swing Extensions</name>
	<description>A set of additional swing components by Addy</description>

	<licenses>
		<license>
			<name>Apache License, Version 2.0</name>
			<distribution>repo</distribution>
			<url>https://www.apache.org/licenses/LICENSE-2.0.html</url>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>michelmbem</id>
			<name>Michel Mbem</name>
			<email>michel.mbem@gmail.com</email>
			<roles>
				<role>developer</role>
			</roles>
			<timezone>America/Toronto</timezone>
			<properties>
				<picUrl>https://avatars.githubusercontent.com/u/25884918?v=4</picUrl>
			</properties>
		</developer>
	</developers>

	<scm>
		<connection>https://github.com/michelmbem/addy-swing-extensions.git</connection>
		<tag>HEAD</tag>
		<url>https://github.com/michelmbem/addy-swing-extensions</url>
	</scm>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub Packages</name>
			<url>https://maven.pkg.github.com/michelmbem/addy-swing-extensions</url>
		</repository>
		<snapshotRepository>
			<id>github</id>
			<name>GitHub Packages Snapshots</name>
			<url>https://maven.pkg.github.com/michelmbem/addy-swing-extensions</url>
		</snapshotRepository>
	</distributionManagement>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>17</maven.compiler.release>
	</properties>

	<repositories>
		<repository>
			<id>github</id>
			<url>https://maven.pkg.github.com/michelmbem/addy-utilitiy-java</url>
		</repository>
	</repositories>

	<dependencies>
		<dependency>
			<groupId>org.addy</groupId>
			<artifactId>addy-util</artifactId>
			<version>2.1.0</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.7.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>17</source>
					<target>17</target>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<mainClass>org.addy.swing.Demo</mainClass>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.0.0</version>
				<configuration>
					<mainClass>org.addy.swing.Demo</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
